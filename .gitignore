# ══════════════════════════════════════════════════════════════
# 跟踪原则：只保留「人写的、不可廉价重建的」内容与代码。
#   ① 内容产物  11408/{books,split,notes}            → 跟踪
#   ② 代码与规范 pipeline/ note-gen/ _vlm/scripts/   → 跟踪
#   ③ 跑脚本可再生的中间产物                          → 忽略
#   ④ 机器状态 / 密钥 / 备份                          → 忽略
# 注意：gitignore 不支持行尾注释，所有说明只能单独成行。
# ══════════════════════════════════════════════════════════════

# ── 扫描原书与可再生的大文件 ───────────────────────────────
# 全部 PDF：扫描原书 + 第 0 步裁剪产物，都可由原书再生
*.pdf
# 扫描原书（大文件，不入库）
11408/pdf/
# 第 0 步 PDF 预裁剪产物（跑 pipeline/scripts/_crop_liang_pdfs.py 可再生）
cropped-pdf/
# 页面渲染与脚本调试残留
tmp/

# ── Python ─────────────────────────────────────────────
__pycache__/

# ── 密钥（永不入库）─────────────────────────────────────
_vlm/.env

# ── _vlm：默认全忽略，只白名单保留「代码 + 规范」─────────────
# 一次性解决新阶段目录被默认跟踪的问题：以后新增 ocr_stage2/ 之类会自动忽略。
# 被忽略项包括 pages/（页面截图）、ocr_stage/（逐页 OCR 中间产物）、
# logs/、md_backup/（批量脚本备份）、repair/、results/（观察表与 JSONL 账本
# 只留本地不上传，其说明书同样是本地文档）以及各类 *.log
_vlm/*
!_vlm/PLAN.md
!_vlm/config.json
!_vlm/scripts/

# ── 笔记生成运行时产物（raw 留档 / 失败清单 / 日志）───────────
_notes_runtime/

# ── Obsidian：跟踪插件本体与配置，只忽略备份与窗口状态 ──────────
# 插件本体与清单必须跟踪。Obsidian 缺 main.js 会直接加载失败；
# 而只跟 manifest.json 会留下「有清单没代码」的错位，克隆下来是一堆报错。
# （2026-09 复盘：曾经取消跟踪 → 插件全部加载失败，见 commit 08e313d）
# 插件自动备份（realclaudian 一份约 5 MB，且每次升级都会新生成）→ 忽略
.obsidian/plugins/*/backup-*/
# 打开的文件与面板布局，属机器状态
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# ── Claudian（AI 助手插件）：整体忽略（含设置与会话记录）──────────
.claudian/

# ── Claude Code ────────────────────────────────────────
.claude/

# ── 外部参考（第三方 skill 克隆，只作本地查阅）─────────────
# 上游 Kosthi/11408.skill（MIT）：只作设计参考，是独立 git 仓库，不入本库
11408.skill/